<nav class="nav">
  <a class="nav-logo" href="/">
    <%- include('logo', { cls: 'nav-logo-svg' }) %>
    <span class="nav-logo-text">ShelfLife</span>
  </a>
  <% if (typeof profile !== 'undefined' && profile) { %>
  <span class="nav-crumb">/ <%= profile.display_name %></span>
  <div class="nav-actions">
    <button class="nav-refresh-btn" id="nav-refresh-btn" title="Re-fetch Steam data and rebuild recommendations">↺ Re-fetch</button>
    <a class="nav-link" href="/">Search another profile</a>
    <img class="nav-avatar" src="<%= profile.avatar_url %>" alt="<%= profile.display_name %>'s Steam avatar" width="30" height="30">
  </div>
  <% } %>
</nav>
