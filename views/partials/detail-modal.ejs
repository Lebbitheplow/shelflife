<div class="modal-backdrop" id="modal-backdrop" hidden>
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
    <div class="modal-hero" id="modal-hero"></div>
    <div class="modal-body">
      <img class="modal-poster" id="modal-poster" src="" alt="">
      <div class="modal-info">
        <h2 class="modal-title" id="modal-title"></h2>
        <div class="modal-meta" id="modal-meta"></div>
        <div class="modal-ratings" id="modal-ratings"></div>
        <div class="modal-stats" id="modal-stats"></div>
        <div class="modal-reasons" id="modal-reasons"></div>
        <div class="modal-tags" id="modal-tags"></div>
        <p class="modal-desc" id="modal-desc"></p>
        <div class="modal-actions" id="modal-actions">
          <a class="btn btn-steam" id="modal-steam-btn" href="#" target="_blank" rel="noopener">Open in Steam</a>
          <button class="btn btn-ghost danger" id="modal-dismiss-btn" type="button">✕ Not Interested</button>
        </div>
      </div>
    </div>
    <div class="modal-trailer" id="modal-trailer">
      <video class="modal-video" id="modal-video" muted loop playsinline controls></video>
      <iframe class="modal-yt" id="modal-yt" title="Trailer" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
</div>
