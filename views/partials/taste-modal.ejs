<% const guide = [
  ['top',  '80–100', 'Outstanding match', 'shares your favourite genres, beloved developers, and niche taste.'],
  ['high', '60–79',  'Strong match',      'aligns well with your play history and genre preferences.'],
  ['mid',  '40–59',  'Decent match',      'some elements overlap your taste; could be a pleasant surprise.'],
  ['low',  '20–39',  'Partial match',     'limited overlap with your profile; a niche pick.'],
  ['none', '<20',    'Weak match',        "in your library but doesn't reflect your usual taste."],
]; %>
<div class="taste-backdrop" id="taste-backdrop" hidden>
  <div class="taste-modal" id="taste-modal" role="dialog" aria-modal="true" aria-label="Taste Profile and Score Guide">
    <button class="taste-modal-close" id="taste-modal-close" aria-label="Close">✕</button>
    <div class="taste-modal-body">
      <div>
        <h3 class="taste-modal-heading">Your Taste Profile</h3>
        <ul class="taste-interests-list" id="taste-interests-list">
          <li class="taste-loading">Loading…</li>
        </ul>
      </div>
      <div>
        <h3 class="taste-modal-heading">Shelf Score Guide</h3>
        <p class="taste-guide-intro">How well a game matches your library and taste. Click any score badge to see why.</p>
        <ul class="taste-guide-list">
          <% for (const [tier, range, label, desc] of guide) { %>
          <li>
            <div class="taste-guide-badge tier--<%= tier %>">
              <svg viewBox="0 0 32 27" fill="none" aria-hidden="true"><path d="M16,8 C12,2 4,4 4,10 C4,17 10,21 16,25 C22,21 28,17 28,10 C28,4 20,2 16,8Z" stroke="currentColor" stroke-width="1.3"/><polyline points="5,14 8,14 10,12 12,20 14,6 16,14 20,14 27,14" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span><%= range %></span>
            </div>
            <div class="taste-guide-desc"><strong><%= label %></strong> — <%= desc %></div>
          </li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>
</div>
