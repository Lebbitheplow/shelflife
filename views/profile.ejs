<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: `${profile.display_name} — ShelfLife`, sheets: ['library', 'modal'] }) %>
  <link rel="manifest" href="/manifest/<%= steamId %>.json">
  <link rel="apple-touch-icon" href="/icons/icon.svg">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="ShelfLife">
</head>
<body>
  <%- include('partials/nav', { profile }) %>

  <main class="main-content" id="main-content">

    <% if (isError) { %>
    <div class="load-error">
      <p><%= errorMessage %></p>
      <a href="/" class="btn btn-primary">Try Again</a>
    </div>

    <% } else if (isLoading) { %>
    <div class="loading-state" id="loading-state">
      <div class="loading-spinner"></div>
      <div class="loading-title">Building your shelf…</div>
      <div class="loading-bar-wrap"><div class="loading-bar" id="loading-bar"></div></div>
      <div class="loading-sub"><span id="loading-message">Loading your Steam library</span><br>Next visit loads from cache</div>
    </div>

    <% } else { %>
    <!-- Spotlight hero: top pick + up-next queue (hydrated by app.js) -->
    <section class="hero hero--skeleton" id="hero" aria-label="Top of your shelf">
      <div class="hero-shade"></div>
    </section>

    <div class="stats-row">
      <div id="profile-stats" style="display:contents"></div>
      <div class="stats-actions">
        <button class="btn-taste" id="nav-taste-btn" title="Taste Profile &amp; Score Guide" type="button">
          <svg viewBox="0 0 32 27" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16,8 C12,2 4,4 4,10 C4,17 10,21 16,25 C22,21 28,17 28,10 C28,4 20,2 16,8Z" fill="rgba(16,185,129,0.22)" stroke="currentColor" stroke-width="1.4"/>
            <polyline points="5,14 8,14 10,12 12,20 14,6 16,14 20,14 27,14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Taste Profile</span>
        </button>
        <button class="btn-outline" id="shuffle-all-btn" type="button">↺ Shuffle</button>
      </div>
    </div>

    <div class="tabs" role="tablist" aria-label="Recommendation source">
      <button class="tab" role="tab" id="tab-shelf" aria-selected="true" aria-controls="panel-shelf" data-tab="shelf">My Shelf</button>
      <button class="tab" role="tab" id="tab-store" aria-selected="false" aria-controls="panel-store" data-tab="store">Steam Store</button>
    </div>

    <div id="panel-shelf" role="tabpanel" aria-labelledby="tab-shelf">
      <%- include('partials/section', { key: 'topPicks', title: 'Top Picks for You' }) %>
      <%- include('partials/section', { key: 'friendsPlayed', title: 'Friends Are Playing', hidden: true }) %>
      <%- include('partials/section', { key: 'neverTouched', title: 'Never Touched' }) %>
      <%- include('partials/section', { key: 'almostStarted', title: 'Almost Started' }) %>
      <%- include('partials/section', { key: 'byGenre', title: 'By Genre', control: '<select class="genre-select" id="genre-select" aria-label="Genre"></select>' }) %>
    </div>

    <div id="panel-store" role="tabpanel" aria-labelledby="tab-store" hidden>
      <p class="tab-note" id="store-note">GAMES YOU DON'T OWN, RANKED AGAINST YOUR TASTE · PRICES FROM THE STEAM STORE</p>
      <div class="loading-state loading-state--inline" id="store-loading" hidden>
        <div class="loading-spinner"></div>
        <div class="loading-title">Browsing the Steam store…</div>
        <div class="loading-bar-wrap"><div class="loading-bar" id="store-loading-bar"></div></div>
        <div class="loading-sub"><span id="store-loading-message">Starting</span><br>This runs once, then refreshes every 12 hours</div>
      </div>
      <div class="load-error" id="store-error" hidden>
        <p id="store-error-message"></p>
        <button class="btn btn-primary" id="store-retry-btn" type="button">Try Again</button>
      </div>
      <div id="store-sections" hidden>
        <%- include('partials/section', { key: 'storePicks', title: 'Picked For You', sub: '' }) %>
        <%- include('partials/section', { key: 'storeSale', title: 'On Sale Now' }) %>
        <%- include('partials/section', { key: 'storeFree', title: 'Free To Play', hidden: true }) %>
      </div>
    </div>
    <% } %>

  </main>

  <%- include('partials/detail-modal') %>
  <%- include('partials/taste-modal') %>

  <script>
    const STEAM_ID = '<%= steamId %>';
    const IS_LOADING = <%= isLoading ? 'true' : 'false' %>;
  </script>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js"></script>
  <script src="/js/helpers.js?v=<%= assetV %>"></script>
  <script src="/js/cards.js?v=<%= assetV %>"></script>
  <script src="/js/modal.js?v=<%= assetV %>"></script>
  <script src="/js/app.js?v=<%= assetV %>"></script>
  <script src="/js/store.js?v=<%= assetV %>"></script>
  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
  </script>
</body>
</html>
