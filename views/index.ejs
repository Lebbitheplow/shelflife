<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: 'ShelfLife', sheets: ['landing'] }) %>
</head>
<body class="landing-body">
  <div class="landing-backdrop" aria-hidden="true">
    <img class="landing-backdrop-img" src="https://cdn.cloudflare.steamstatic.com/steam/apps/1245620/library_hero.jpg" alt="">
    <img class="landing-capsule c1" src="https://cdn.cloudflare.steamstatic.com/steam/apps/1145360/library_600x900.jpg" alt="">
    <img class="landing-capsule c2" src="https://cdn.cloudflare.steamstatic.com/steam/apps/367520/library_600x900.jpg" alt="">
    <img class="landing-capsule c3" src="https://cdn.cloudflare.steamstatic.com/steam/apps/504230/library_600x900.jpg" alt="">
    <img class="landing-capsule c4" src="https://cdn.cloudflare.steamstatic.com/steam/apps/632470/library_600x900.jpg" alt="">
  </div>

  <%- include('partials/nav', { profile: null }) %>

  <main class="landing-main">
    <div class="landing-hero">
      <div class="landing-logo">
        <%- include('partials/logo', { cls: 'landing-logo-svg' }) %>
        <span class="landing-logo-name">ShelfLife</span>
      </div>
      <p class="landing-tagline">Discover games you already own — but haven't played yet.</p>
      <p class="landing-sub">Paste your Steam profile URL and get personalized picks from your own library, scored by what you demonstrably love.</p>

      <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
      <div class="landing-error"><%= errorMsg %></div>
      <% } %>

      <form class="landing-form" id="search-form">
        <input
          class="landing-input"
          id="profile-input"
          type="text"
          placeholder="https://steamcommunity.com/id/yourname"
          autocomplete="off"
          spellcheck="false"
          aria-label="Steam profile URL"
        />
        <button class="btn btn-primary landing-btn" type="submit">Explore My Library</button>
      </form>
      <p class="landing-hint">Your Steam profile must be set to <strong>Public</strong> for this to work.</p>
    </div>
  </main>

  <script src="/js/landing.js?v=<%= assetV %>"></script>
</body>
</html>
